{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carterita-avisos",
  "main": "push-service/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://justacheeseondrugs-cmd.github.io",
    "APP_URL": "https://justacheeseondrugs-cmd.github.io/cartera_propiedades/",
    "TRANSCRIBE_DAILY_LIMIT": "20",
    "TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REMINDERS",
        "class_name": "ReminderService"
      },
      {
        "name": "VOICE_USAGE",
        "class_name": "VoiceUsage"
      },
      {
        "name": "CALENDAR_AUTH",
        "class_name": "CalendarAuth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReminderService"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "VoiceUsage"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CalendarAuth"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
